if hexo-config('preloader')
  .loading-bg
    display: flex;
    width: 100%;
    height: 100%;
    position: fixed;
    background: var(--preloader-bg);
    z-index: 1001;
    opacity: 1;
    transition: .3s;
  #loading-box
    &.loaded
      .loading-bg
        opacity: 0;
        z-index: -1000;
      
  @keyframes loadingAction
    0% {
        opacity: 1;
    }

    25% {
        opacity: .8;
    }

    50% {
        opacity: .6;
    }

    75% {
        opacity: .4;
    }

    100% {
        opacity: .2;
    }
