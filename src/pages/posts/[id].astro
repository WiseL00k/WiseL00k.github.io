---
import { render } from 'astro:content';
import Video from '@/components/Video.astro';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPosts, postSlug } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const seen = new Map<string, string>();
  for (const post of posts) {
    const slug = postSlug(post);
    if (seen.has(slug)) throw new Error(`文章 URL 重复：${slug}（${seen.get(slug)} 与 ${post.id}）`);
    seen.set(slug, post.id);
  }
  return posts.map((post, i) => ({
    params: { id: postSlug(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={older} next={newer}>
  <Content components={{ Video }} />
</PostLayout>
