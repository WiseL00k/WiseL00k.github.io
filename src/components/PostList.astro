---
import { formatDate } from '@/utils/date';
import { postSlug, postUrl, type Post } from '@/utils/posts';
import { transitionName } from '@/utils/text';
import Icon from './Icon.astro';

interface Props {
  posts: Post[];
  showTags?: boolean;
}

const { posts, showTags = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post, i) => (
      <li data-reveal style={`--i: ${Math.min(i, 6)}`}>
        <a class="row" href={postUrl(post)}>
          <time class="meta" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span class="post-title">
            <span class="vt-text" style={`view-transition-name: ${transitionName('post', postSlug(post))}`}>
              {post.data.title}
            </span>
          </span>
          {showTags && post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </span>
          )}
          <Icon name="arrow-right" class="arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--hairline);
  }

  .row {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 20px;
    margin-inline: -14px;
    padding: 16px 14px;
    border-radius: var(--radius);
    transition: background-color var(--dur-fast) var(--ease);
  }

  .row:hover {
    background: var(--surface-2);
  }

  .post-title {
    display: block;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .tags {
    display: flex;
    gap: 6px;
  }

  .row :global(.arrow) {
    color: var(--text-3);
    transition:
      transform var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .row:hover :global(.arrow) {
    color: var(--text);
    transform: translateX(3px);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 16px;
      gap: 4px 12px;
    }

    .row time {
      grid-column: 1;
    }

    .post-title {
      grid-column: 1;
      grid-row: 2;
    }

    .tags {
      display: none;
    }

    .row :global(.arrow) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
