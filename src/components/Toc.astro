---
import type { MarkdownHeading } from 'astro';

interface Props {
  items: MarkdownHeading[];
}

const { items } = Astro.props;
const base = Math.min(...items.map((h) => h.depth));
---

<ol class="toc">
  {
    items.map((heading) => (
      <li class:list={[{ sub: heading.depth > base }]}>
        <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
          {heading.text}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .toc {
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 1.5;
  }

  li + li {
    margin-top: 2px;
  }

  .sub {
    padding-left: 12px;
  }

  a {
    display: block;
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    color: var(--text-3);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  a:hover {
    color: var(--text);
  }

  a[data-active] {
    color: var(--text);
    background: var(--surface-2);
  }
</style>
